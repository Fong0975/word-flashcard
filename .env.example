# Services Port
# (They will also be used during Docker Compose operations)
APP_PORT=8080
FRONTEND_PORT=3000

# Frontend API Configuration
# (Baked into the frontend build via Docker build args -- see web/Dockerfile)
VITE_API_HOSTNAME=localhost
VITE_API_PORT=8080

# Frontend Template Buttons Configuration
# - TEMPLATE_CONFIG_HOST_DIR: absolute host directory to bind-mount over the
#   built app's `config/` folder (the optional, gitignored *ButtonsConfig.json
#   files fetched at runtime by useTemplateButtons), so they can be swapped
#   without rebuilding the image; default (`./web/public/config`) is relative
#   to wherever docker-compose.yml is run from -- override with an absolute
#   path when that directory isn't stable (e.g. deployed via Portainer)
TEMPLATE_CONFIG_HOST_DIR=./web/public/config

# Logging Configuration
# - LOG_HOST_DIR: absolute host directory to bind-mount container logs into;
#   default (`.`) is relative to wherever docker-compose.yml is run from --
#   override with an absolute path when that directory isn't stable (e.g.
#   deployed via Portainer, which clones the repo into its own internal
#   working directory)
# - Level: DEBUG, INFO, WARN, ERROR
# - LOG_NOTIFY_LEVEL: minimum severity that raises the unread indicator on
#   the frontend's log page (DEBUG, INFO, WARN, ERROR)
# - LOG_STATE_FILE_PATH: where the "logs read up to here" watermark is stored;
#   defaults to `.log-read-state.json` beside LOG_FILE_PATH, which is already
#   bind-mounted via LOG_HOST_DIR, so it survives a container rebuild
# - WARNING: do NOT use DEBUG in deployment. At DEBUG the application logs
#   full request and response bodies plus SQL statements with their bound
#   parameters, which the log viewing API would then expose
LOG_HOST_DIR=.
LOG_FILE_PATH=word-flashcard.log
LOG_FILE_MAX_SIZE_MB=10
LOG_LEVEL=INFO
LOG_NOTIFY_LEVEL=WARN
LOG_STATE_FILE_PATH=

# Automatic Backup Configuration
# - BACKUP_ENABLED: set to false to disable the automatic backup scheduler entirely (including the startup backup)
# - BACKUP_HOST_DIR: absolute host directory to bind-mount backups into; same
#   override behavior as LOG_HOST_DIR above
# - BACKUP_INTERVAL_HOURS: how old the newest backup must be before a new one is due
# - BACKUP_CHECK_INTERVAL_HOURS: how often to re-check the above
BACKUP_ENABLED=true
BACKUP_HOST_DIR=./backups
BACKUP_DIR=backups
BACKUP_INTERVAL_HOURS=72
BACKUP_CHECK_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=10

# Database Configuration
# Supported types: mysql, postgresql
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=word_flashcard

# Service Environment
DEV_MODE=false