{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:react/recommended",
    "plugin:react/jsx-runtime",
    "plugin:react-hooks/recommended",
    "prettier"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": ["prettier", "tailwindcss", "@typescript-eslint", "react", "react-hooks", "import"],
  "settings": {
    "react": {
      "version": "detect"
    },
    "tailwindcss": {
      "config": "./tailwind.config.js"
    }
  },
  "rules": {
    // TypeScript specific rules
    "@typescript-eslint/no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "@typescript-eslint/no-explicit-any": "warn",

    // React specific rules
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    // TypeScript's own type checking supersedes PropTypes; react-app's legacy
    // config excluded this rule for the same reason.
    "react/prop-types": "off",

    // Import/Export rules
    "import/order": ["warn", {
      "groups": ["builtin", "external", "internal", "parent", "sibling", "index"],
      "newlines-between": "always"
    }],

    // General code quality rules
    "no-console": "warn",
    "no-debugger": "error",
    "no-duplicate-imports": "error",
    "prefer-const": "error",
    "no-var": "error",
    "eqeqeq": ["error", "always"],
    "curly": ["error", "all"],

    // Prettier integration
    "prettier/prettier": "error",

    // Tailwind CSS rules
    "tailwindcss/classnames-order": "warn",
    "tailwindcss/no-custom-classname": "warn",
    "tailwindcss/no-contradicting-classname": "error"
  },
  "overrides": [
    {
      "files": ["src/**/*.{ts,tsx}"],
      "excludedFiles": ["src/lib/api.ts"],
      "rules": {
        "max-lines": ["warn", { "max": 380, "skipBlankLines": false, "skipComments": false }]
      }
    },
    {
      "files": ["src/**/*.test.{ts,tsx}"],
      "rules": {
        "react/display-name": "off"
      }
    }
  ]
}
